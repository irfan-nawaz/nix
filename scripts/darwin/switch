#!/usr/bin/env bash
set -euo pipefail

# Run from repo root regardless of caller cwd so the flake reference
# and the ./result-darwin-${host} symlink resolve consistently.
cd "$(dirname "$0")/../.."

host="${1:-}"
if [ -z "$host" ]; then
  echo "usage: $(basename "$0") <hostname>" >&2
  exit 1
fi

scripts/darwin/build-system "$host"
echo "switching to new config for ${host}"
sudo "./result-darwin-${host}/sw/bin/darwin-rebuild" switch --flake ".#${host}"

# The symlink is only needed to point sudo at the just-built activator.
# After a successful switch, the closure is registered with the system
# and the symlink is just clutter that pins the build in the GC root.
rm -f "./result-darwin-${host}"
